#!/usr/bin/env bash
#
# archidev-flow - deprecated compatibility shim.
#
# The prototype is now called ArchiDev2 and its launcher is `archidev2`.
# This shim exists only so an existing symlink on PATH keeps working; it
# forwards every argument unchanged and adds nothing else.
#
set -euo pipefail

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  target=$(readlink -- "$self")
  if [[ $target == /* ]]; then self=$target; else self=$(dirname -- "$self")/$target; fi
done
root=$(CDPATH= cd -P -- "$(dirname -- "$self")/.." && pwd -P)

printf 'archidev-flow: deprecated - this prototype is now "archidev2". Running %s/bin/archidev2 instead.\n' \
  "$root" >&2

exec "$root/bin/archidev2" "$@"
