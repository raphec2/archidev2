#!/usr/bin/env bash
#
# archidev-pane - the program every ArchiDev-Flow pane actually runs.
#
#   archidev-pane <role> [command [args...]]
#
# Responsibilities:
#   1. Tag the pane with a stable identity (OSC 1337 user var + OSC 0 title)
#      so the WezTerm Lua config can route text to it without guessing.
#   2. Set EDITOR/VISUAL for the files pane only - never globally.
#   3. Run the requested command, and when it exits leave a usable interactive
#      shell behind instead of destroying the pane.
#
# Deliberately not `set -e`: a failing AI command must not kill the pane.
set -uo pipefail

role=${1:-shell}
shift || true

# --- pane identity ---------------------------------------------------------
# WezTerm reads OSC 1337 SetUserVar and exposes it to Lua via
# pane:get_user_vars(). The value must be base64. This is what makes
# "send selection to Consultant" reliable even after a config reload, and it
# is scoped to this pane only.
set_user_var() {
  local name=$1 value=$2 b64
  command -v base64 >/dev/null 2>&1 || return 0
  b64=$(printf '%s' "$value" | base64 | tr -d '\n')
  printf '\033]1337;SetUserVar=%s=%s\007' "$name" "$b64"
}

case $role in
  consultant) title='ArchiDev Consultant' ;;
  developer)  title='ArchiDev Developer' ;;
  files)      title='ArchiDev Files' ;;
  *)          title="ArchiDev ${role}" ;;
esac

set_user_var ARCHIDEV_ROLE "$role"
set_user_var ARCHIDEV_SESSION "${ARCHIDEV_SESSION_ID:-unknown}"
printf '\033]0;%s\007' "$title"

# --- files pane: editor wiring --------------------------------------------
# Exported here so the file manager (and any shell that replaces it in this
# pane) opens the configured editor. The user's login shell config is never
# touched.
if [[ $role == files ]]; then
  editor=${ARCHIDEV_EDITOR_COMMAND:-}
  if [[ -z $editor ]]; then
    for cand in micro nano vi; do
      if command -v -- "$cand" >/dev/null 2>&1; then editor=$cand; break; fi
    done
  fi
  if [[ -n $editor ]]; then
    export EDITOR=$editor VISUAL=$editor
  else
    printf '\033[33marchidev: no editor found (tried micro, nano, vi).\033[0m\n'
    printf '\033[33m          Set EDITOR_COMMAND in the ArchiDev config.\033[0m\n'
  fi
fi

banner() { printf '\033[2m%s\033[0m\n' "$*"; }

# --- run the command -------------------------------------------------------
status=0
if (($#)); then
  if command -v -- "$1" >/dev/null 2>&1; then
    "$@"
    status=$?
  else
    printf '\033[31marchidev: command not found: %s\033[0m\n' "$1"
    status=127
  fi
else
  banner "archidev: no command configured for the '$role' pane."
fi

# --- keep the pane usable --------------------------------------------------
banner "----------------------------------------------------------------"
banner "archidev: '$role' command exited with status $status."
banner "This pane is now a plain shell; re-run the command or close it."
banner "----------------------------------------------------------------"

# Re-tag: the exited program may have changed the pane title. The user var is
# still set, but refreshing both is cheap and keeps routing discoverable.
set_user_var ARCHIDEV_ROLE "$role"
printf '\033]0;%s (shell)\007' "$title"

exec "${SHELL:-/bin/bash}" -i
