#!/usr/bin/env bash
#
# ad2-pane - the program every ArchiDev2 pane actually runs.
#
#   ad2-pane <role> [command [args...]]
#
# Responsibilities:
#   1. Tag the pane with a stable identity (OSC 1337 user var + OSC 0 title)
#      so the WezTerm Lua config can route text to it without guessing.
#   2. Set EDITOR/VISUAL for the files pane only - never globally.
#   3. Run the requested command, and when it exits leave a usable interactive
#      shell behind instead of destroying the pane.
#
# Output discipline: this script writes two short lines when a command exits,
# and nothing else. Guidance lives in the status bar and the Alt+H overlay so
# that AI sessions and their scrollback stay clean.
#
# Deliberately not `set -e`: a failing AI command must not kill the pane.
set -uo pipefail

role=${1:-shell}
shift || true

# --- pane identity ---------------------------------------------------------
# WezTerm reads OSC 1337 SetUserVar and exposes it to Lua via
# pane:get_user_vars() and via PaneInformation.user_vars in status events.
# The value must be base64. This is what makes "send selection to CONSULTANT"
# reliable, and it is scoped to this pane only.
set_user_var() {
  local name=$1 value=$2 b64
  command -v base64 >/dev/null 2>&1 || return 0
  b64=$(printf '%s' "$value" | base64 | tr -d '\n')
  printf '\033]1337;SetUserVar=%s=%s\007' "$name" "$b64"
}

case $role in
  consultant) label='CONSULTANT' ;;
  developer)  label='DEVELOPER' ;;
  files)      label='FILES' ;;
  *)          label=${role^^} ;;
esac
title="ArchiDev2 $label"

set_user_var ARCHIDEV2_ROLE "$role"
set_user_var ARCHIDEV2_SESSION "${ARCHIDEV2_SESSION_ID:-unknown}"
printf '\033]0;%s\007' "$title"

# --- files pane: editor wiring --------------------------------------------
# Exported here so the file manager (and any shell that replaces it in this
# pane) opens the configured editor. The user's login shell config is never
# touched.
if [[ $role == files ]]; then
  editor=${ARCHIDEV2_EDITOR_COMMAND:-}
  if [[ -z $editor ]]; then
    for cand in micro nano vi; do
      if command -v -- "$cand" >/dev/null 2>&1; then editor=$cand; break; fi
    done
  fi
  if [[ -n $editor ]]; then
    export EDITOR=$editor VISUAL=$editor
  else
    printf '\033[33marchidev2: no editor found (tried micro, nano, vi).\033[0m\n'
    printf '\033[33m           Set EDITOR_COMMAND in the ArchiDev2 config.\033[0m\n'
  fi
fi

dim() { printf '\033[2m%s\033[0m\n' "$*"; }

# --- run the command -------------------------------------------------------
status=0
if (($#)); then
  if command -v -- "$1" >/dev/null 2>&1; then
    "$@"
    status=$?
  else
    printf '\033[31marchidev2: command not found: %s\033[0m\n' "$1"
    status=127
  fi
else
  dim "archidev2: no command configured for the '$role' pane."
fi

# --- keep the pane usable --------------------------------------------------
# Two lines, not a banner: this runs again every time the user exits a shell,
# so it must stay small.
dim "archidev2: $label exited (status $status) - this pane is now a shell."
set_user_var ARCHIDEV2_ROLE "$role"
printf '\033]0;%s (shell)\007' "$title"

exec "${SHELL:-/bin/bash}" -i
