[[ -e "$m4/archidev2/config" ]] && bad 'migrate: no empty config written' || ok 'migrate: no empty config written'

# --- a legacy *directory* where the config file should be is not fatal ---
m5="$SANDBOX/m5"; mkdir -p "$m5/archidev-flow/config"
