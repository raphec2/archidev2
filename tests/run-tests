# ---------------------------------------------------------------------------
note '15. Legacy config migration'
# ---------------------------------------------------------------------------
# The old prototype wrote ~/.config/archidev-flow/config. That directory is
# SHARED with the old ArchiDev-Flow Electron app, so migration must read one
# file and touch nothing else.

mk_legacy() { # <dir> -> creates a realistic legacy dir with decoy Electron files
  local d=$1
  mkdir -p "$d/workspaces/ws1" "$d/Cache"
  printf "# ArchiDev-Flow configuration\nCONSULTANT_DIR='%s'\nDEVELOPER_COMMAND='claude'\n" \
    "$consult" >"$d/config"
  chmod 0640 "$d/config"
  printf 'electron-cookies' >"$d/Cookies"
  printf 'notes' >"$d/notes.md"
  printf '{"legacy":true}' >"$d/config.legacy.json"
}

# --- old exists, new missing -> migrate ---
m1="$SANDBOX/m1"; mkdir -p "$m1"
mk_legacy "$m1/archidev-flow"
AD2_CONFIG=()
ad2_migrate_legacy_config "$m1/archidev2/config" "$m1/archidev-flow/config" 2>"$SANDBOX/m1.log"
assert_rc 'migrate: old present + new missing -> migrates' 0 $?
[[ -f "$m1/archidev2/config" ]] && ok 'migrate: new config created' || bad 'migrate: new config created'
AD2_CONFIG=(); ad2_config_load "$m1/archidev2/config" 2>/dev/null
assert_eq 'migrate: CONSULTANT_DIR carried across' "$consult" "$(ad2_config_get CONSULTANT_DIR)"
assert_eq 'migrate: DEVELOPER_COMMAND carried across' 'claude' "$(ad2_config_get DEVELOPER_COMMAND)"
assert_eq 'migrate: permissions preserved from the old file' '640' "$(stat -c '%a' "$m1/archidev2/config")"
assert_eq 'migrate: new config dir is 0700' '700' "$(stat -c '%a' "$m1/archidev2")"
assert_contains 'migrate: reports what it did' 'migrated settings from the previous prototype' "$(cat "$SANDBOX/m1.log")"
assert_contains 'migrate: names the source file' "$m1/archidev-flow/config" "$(cat "$SANDBOX/m1.log")"
assert_contains 'migrate: says the old file was kept' 'left untouched' "$(cat "$SANDBOX/m1.log")"
assert_not_contains 'migrate: new file has no old product name' 'ArchiDev-Flow' "$(cat "$m1/archidev2/config")"

# nothing in the shared legacy directory may be removed or altered
[[ -f "$m1/archidev-flow/config" ]] && ok 'migrate: old config not deleted' || bad 'migrate: old config not deleted'
assert_eq 'migrate: old config unchanged' '640' "$(stat -c '%a' "$m1/archidev-flow/config")"
assert_contains 'migrate: old config content intact' 'ArchiDev-Flow configuration' "$(cat "$m1/archidev-flow/config")"
for decoy in Cookies notes.md config.legacy.json workspaces/ws1 Cache; do
