done
grep -q 'focus moved' "$LUA" && ok 'lua confirms focus movement after routing' || bad 'lua confirms focus movement'

# Live testing showed Micro's selection is invisible to WezTerm, so no in-product
# text may tell the user to Shift-drag in Micro to route a selection.
if grep -niE 'shift[- ]drag|hold shift while dragging' "$LUA" >/dev/null; then
  bad 'lua help does not promise Shift-drag selection from Micro'
  grep -niE 'shift[- ]drag|hold shift while dragging' "$LUA" | head -3
else
  ok 'lua help does not promise Shift-drag selection from Micro'
fi
if grep -niE 'shift[- ]drag|hold shift while dragging' "$ROOT/bin/archidev2" >/dev/null; then
  bad 'startup hint does not promise Shift-drag selection from Micro'
else
  ok 'startup hint does not promise Shift-drag selection from Micro'
fi
grep -q 'Ctrl+C' "$LUA" && ok 'lua help points at the Ctrl+C clipboard route for Micro' \
  || bad 'lua help points at the Ctrl+C clipboard route for Micro'
grep -q "copy with Ctrl+C" "$ROOT/bin/archidev2" \
  && ok 'startup hint points at the Ctrl+C clipboard route' \
  || bad 'startup hint points at the Ctrl+C clipboard route'

# The README must carry the tested interaction matrix, not an aspirational one.
readme="$ROOT/README.md"
grep -q 'What works where (tested)' "$readme" \
  && ok 'README documents the tested interaction matrix' \
  || bad 'README documents the tested interaction matrix'
for row in 'CONSULTANT' 'DEVELOPER' 'Micro' 'Another application'; do
  grep -q "^| \*\*$row\*\*" "$readme" || grep -q "| \*\*$row\*\*" "$readme" \
    && ok "README matrix has a row for $row" || bad "README matrix has a row for $row"
done
grep -q 'get_selection_text_for_pane' "$readme" \
  && ok 'README explains why Micro selection is unreadable' \
  || bad 'README explains why Micro selection is unreadable'
if grep -nE 'Shift-drag to select|hold Shift while dragging' "$readme" >/dev/null; then
  bad 'README does not instruct Shift-drag selection from Micro'
  grep -nE 'Shift-drag to select|hold Shift while dragging' "$readme" | head -3
else
  ok 'README does not instruct Shift-drag selection from Micro'
fi
grep -q 'active_notice' "$LUA" && ok 'lua suppresses status repaint over a confirmation' || bad 'lua notice suppression'
# One shared action_callback per overlay: creating them per click leaks events.
cb=$(grep -v '^\s*--' "$LUA" | grep -c 'wezterm.action_callback')
if (( cb <= 2 )); then ok "lua registers few action callbacks ($cb)"; else bad "lua registers $cb action callbacks (leaks per click)"; fi
grep -q "mouse_reporting = true" "$LUA" && bad 'lua does not steal the mouse from Micro/Yazi' \
  || ok 'lua does not steal the mouse from Micro/Yazi'
grep -qE 'event = \{ Up = \{ streak = 1, button = MOUSE_MENU_BUTTON \} \}' "$LUA" \
  && ok 'lua binds the action menu to the Up event' \
  || bad 'lua binds the action menu to the Up event'
if grep -B2 -A2 "EmitEvent 'archidev2-action-menu'" "$LUA" | grep -q 'Down = { streak'; then
  bad 'lua no longer opens the menu on Down'
else
  ok 'lua no longer opens the menu on Down'
fi
if grep -nE '\bos\.execute\b|\bio\.popen\b' "$LUA" >/dev/null; then
  bad 'lua does not shell out'
else
  ok 'lua does not shell out'
fi

# The installed wezterm validates the whole config, including mouse bindings
# and every key spec we generate.
if command -v wezterm >/dev/null 2>&1; then
  keys_env=$(printf 'KEY_SEND_SELECTION_CONSULTANT\tALT|SHIFT\tc\nKEY_HELP\tALT\th\nKEY_ZOOM\tALT\tz\n')
  if o=$(ARCHIDEV2_KEYS="$keys_env" ARCHIDEV2_MOUSE_MENU_BUTTON=Right \
         wezterm --config-file "$LUA" show-keys 2>&1 >"$SANDBOX/keys.txt"); then
    ok 'wezterm accepts the config with generated key and mouse bindings'
  else
    bad "wezterm rejected the config: $o"
  fi
  kt=$(cat "$SANDBOX/keys.txt")
  assert_contains 'wezterm registered the send-selection binding' 'archidev2-send-selection-consultant' "$kt"
  assert_contains 'wezterm registered the help binding' 'archidev2-help' "$kt"
  # The menu must open on the completed click (Up). Opening on Down let the
  # release land on the freshly opened InputSelector and dismiss it, which is
  # what a trackpad tap always did.
  if printf '%s' "$kt" | grep -qE 'Up \{ streak: 1, button: Right \} +-> +EmitEvent\("archidev2-action-menu"\)'; then
    ok 'right-click menu opens on mouse Up'
  else
    bad 'right-click menu opens on mouse Up'
  fi
  if printf '%s' "$kt" | grep -qE 'Down \{ streak: 1, button: Right \} +-> +EmitEvent\("archidev2-action-menu"\)'; then
    bad 'right-click menu does not also fire on mouse Down'
  else
    ok 'right-click menu does not also fire on mouse Down'
  fi
  # Down must be neutralised, or a button with a WezTerm default (middle-click
  # paste) would act on press and then open the menu on release.
  if printf '%s' "$kt" | grep -qE 'Down \{ streak: 1, button: Right \} +-> +Nop'; then
    ok 'menu button press is a no-op'
  else
    bad 'menu button press is a no-op'
  fi
  # Ordinary selection and copy must be untouched.
  if printf '%s' "$kt" | grep -qE 'Up \{ streak: 1, button: Left \} +-> +CompleteSelection'; then
    ok 'left-button selection and copy left alone'
  else
    bad 'left-button selection and copy left alone'
  fi
  assert_contains 'legacy Ctrl+Alt alias still bound' 'ALT | CTRL' "$kt"
  # Focus and send must stay distinct: Alt+c focuses, Alt+Shift+C sends.
  if printf '%s' "$kt" | grep -qE 'ALT +c +-> +EmitEvent\("archidev2-focus-consultant"\)'; then
    ok 'Alt+C focuses the consultant'
  else
    bad 'Alt+C focuses the consultant'
  fi
  if printf '%s' "$kt" | grep -qE 'ALT +C +-> +EmitEvent\("archidev2-send-selection-consultant"\)'; then
    ok 'Alt+Shift+C sends the selection (distinct from focus)'
  else
    bad 'Alt+Shift+C sends the selection (distinct from focus)'
  fi
  # MOUSE_MENU_BUTTON=Middle must move both entries to the middle button and
  # override WezTerm's default middle-click paste rather than firing with it.
  if o=$(ARCHIDEV2_MOUSE_MENU_BUTTON=Middle wezterm --config-file "$LUA" show-keys 2>&1 >"$SANDBOX/keys-mid.txt"); then
    km=$(cat "$SANDBOX/keys-mid.txt")
    if printf '%s' "$km" | grep -qE 'Up \{ streak: 1, button: Middle \} +-> +EmitEvent\("archidev2-action-menu"\)'; then
      ok 'MOUSE_MENU_BUTTON=Middle opens the menu on middle Up'
    else
      bad 'MOUSE_MENU_BUTTON=Middle opens the menu on middle Up'
    fi
    if printf '%s' "$km" | grep -qE 'Down \{ streak: 1, button: Middle \} +-> +PasteFrom'; then
      bad 'MOUSE_MENU_BUTTON=Middle suppresses the default middle-click paste'
    else
      ok 'MOUSE_MENU_BUTTON=Middle suppresses the default middle-click paste'
    fi
    printf '%s' "$km" | grep -q 'button: Right' \
      && bad 'MOUSE_MENU_BUTTON=Middle leaves the right button free' \
      || ok 'MOUSE_MENU_BUTTON=Middle leaves the right button free'
  else
    bad "wezterm rejected the config with the middle-button menu: $o"
  fi

  # MOUSE_MENU_BUTTON=off must produce no ArchiDev2 mouse binding at all, and
  # must hand the middle button back to WezTerm's default.
  if o=$(ARCHIDEV2_MOUSE_MENU_BUTTON=off wezterm --config-file "$LUA" show-keys 2>&1 >"$SANDBOX/keys-off.txt"); then
    ko=$(cat "$SANDBOX/keys-off.txt")
    printf '%s' "$ko" | grep -q 'archidev2-action-menu.*button\|button.*archidev2-action-menu' \
      && bad 'MOUSE_MENU_BUTTON=off removes the mouse binding' \
      || ok 'MOUSE_MENU_BUTTON=off removes the mouse binding'
    printf '%s' "$ko" | grep -q 'button: Right' \
      && bad 'MOUSE_MENU_BUTTON=off leaves the right button untouched' \
      || ok 'MOUSE_MENU_BUTTON=off leaves the right button untouched'
    if printf '%s' "$ko" | grep -qE 'Down \{ streak: 1, button: Middle \} +-> +PasteFrom'; then
      ok 'MOUSE_MENU_BUTTON=off restores default middle-click paste'
    else
      bad 'MOUSE_MENU_BUTTON=off restores default middle-click paste'
    fi
  else
    bad "wezterm rejected the config with the mouse menu off: $o"
  fi
else
  printf '  \033[2mskip\033[0m wezterm not installed; config not validated\n'
fi

