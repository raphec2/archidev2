ad2_migrate_legacy_config "$m5/archidev2/config" "$m5/archidev-flow/config" 2>/dev/null
assert_rc 'migrate: legacy path that is a directory -> rc 1' 1 $?

# --- end to end through the launcher, and --no-migrate ---
m6="$SANDBOX/m6"; mkdir -p "$m6"
