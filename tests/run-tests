note '19. Lua: focus, labels, menu and mouse'
# ---------------------------------------------------------------------------
for needle in \
  'CONSULTANT' 'DEVELOPER' 'FILES' \
  'inactive_pane_hsb' 'hide_tab_bar_if_only_one_tab = false' \
  'set_left_status' 'InputSelector' 'mouse_bindings' \
