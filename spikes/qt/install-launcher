#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# install-launcher - add a terminal command and a desktop menu entry that open
# one ArchiDev2 project with the native Qt build.
#
# Everything machine-specific (paths, the command name) is written to files
# under your home directory, never into this repository:
#   ~/.local/bin/<command>                       terminal command
#   ~/.local/share/applications/<id>.desktop     menu entry
#   <desktop folder>/<id>.desktop                desktop icon (--desktop-icon)
#
# The project must already have its .archidev2.ini; the launcher only points at
# it and passes no settings of its own.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: install-launcher [--name CMD] [--desktop-icon] [--uninstall] PROJECT_DIR

  --name CMD       terminal command name (default: ad2)
  --desktop-icon   also put an icon on the desktop
  --uninstall      remove what an earlier install with the same --name wrote

The generated command opens PROJECT_DIR with this checkout's
build/qt-spike/archidev2-qt, detached from the terminal. Extra app options
pass through, for example:  ad2 --developer-profile Codex
EOF
}

name=ad2 desktop_icon=0 uninstall=0 project=
while (($#)); do
  case $1 in
    --name) name=${2:?--name needs a value}; shift 2 ;;
    --desktop-icon) desktop_icon=1; shift ;;
    --uninstall) uninstall=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "install-launcher: unknown option $1" >&2; usage >&2; exit 2 ;;
    *) [[ -z $project ]] || { echo "install-launcher: one project only" >&2; exit 2; }
       project=$1; shift ;;
  esac
done
[[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "install-launcher: bad command name: $name" >&2; exit 2; }

bin_dir=${XDG_BIN_HOME:-$HOME/.local/bin}
app_dir=${XDG_DATA_HOME:-$HOME/.local/share}/applications
desk_dir=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
id=archidev2-$name
cmd=$bin_dir/$name
entry=$app_dir/$id.desktop
icon_file=$desk_dir/$id.desktop

if ((uninstall)); then
  for f in "$cmd" "$entry" "$icon_file"; do
    # Only remove files this script generated.
    if [[ -f $f ]] && grep -q 'Generated by ArchiDev2 install-launcher' "$f"; then
      rm -- "$f"; echo "removed $f"
    fi
  done
  exit 0
fi

[[ -n $project ]] || { usage >&2; exit 2; }
project=$(cd -P -- "$project" && pwd -P) || exit 2
[[ -f $project/.archidev2.ini ]] || {
  echo "install-launcher: $project has no .archidev2.ini; run ArchiDev2 there once first:" >&2
  echo "  archidev2-qt --consultant-dir /path/to/consulting $project" >&2
  exit 3
}

repo=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
app=$repo/build/qt-spike/archidev2-qt
[[ -x $app ]] || echo "install-launcher: warning: $app is not built yet" >&2

if [[ -e $cmd ]] && ! grep -q 'Generated by ArchiDev2 install-launcher' "$cmd"; then
  echo "install-launcher: $cmd exists and was not made by this script; choose another --name" >&2
  exit 4
fi

mkdir -p -- "$bin_dir" "$app_dir"

{
  printf '#!/usr/bin/env bash\n'
  printf '# Generated by ArchiDev2 install-launcher. Re-run it to change; --uninstall removes.\n'
  printf 'set -eu\n'
  printf 'app=%q\n' "$app"
  printf 'project=%q\n' "$project"
  cat <<'EOF'
# Desktop sessions do not read ~/.bashrc, so CLIs installed with nvm
# (for example codex) would be missing from PATH, or a system node would win.
# Load nvm's default node, as an interactive terminal would.
if [ -z "${NVM_BIN:-}" ]; then
  export NVM_DIR=${NVM_DIR:-$HOME/.nvm}
  # shellcheck disable=SC1091
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
fi
[ -x "$app" ] || { echo "ArchiDev2 is not built: $app" >&2; exit 1; }
[ -d "$project" ] || { echo "Project folder missing: $project" >&2; exit 1; }
# New session, so closing the terminal does not close ArchiDev2. Errors still
# print here while the terminal stays open.
cd "$project"
exec setsid -f "$app" "$@" "$project"
EOF
} >"$cmd.tmp"
chmod 755 "$cmd.tmp"
mv -f -- "$cmd.tmp" "$cmd"
echo "wrote $cmd"

desktop_entry() {
  cat <<EOF
[Desktop Entry]
# Generated by ArchiDev2 install-launcher. Re-run it to change; --uninstall removes.
Type=Application
Name=ArchiDev2 ($(basename -- "$project"))
Comment=Consultant, Developer and Shell workspace for $project
Exec="$cmd"
Path=$project
Icon=utilities-terminal
Terminal=false
Categories=Development;
StartupWMClass=archidev2-qt
EOF
}

desktop_entry >"$entry"
chmod 644 "$entry"
echo "wrote $entry"
command -v desktop-file-validate >/dev/null && desktop-file-validate "$entry"
command -v update-desktop-database >/dev/null && update-desktop-database -q "$app_dir" 2>/dev/null || true

if ((desktop_icon)); then
  mkdir -p -- "$desk_dir"
  desktop_entry >"$icon_file"
  chmod 755 "$icon_file"
  # Cinnamon and GNOME only run desktop files marked as trusted.
  gio set "$icon_file" metadata::trusted true 2>/dev/null || true
  echo "wrote $icon_file"
fi

case ":$PATH:" in *":$bin_dir:"*) ;; *) echo "note: $bin_dir is not on PATH" >&2 ;; esac
