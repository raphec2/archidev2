#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# install-launcher - add a terminal command and a desktop menu entry that open
# ArchiDev2 projects with the native Qt build.
#
# Everything machine-specific (paths, the command name) is written to files
# under your home directory, never into this repository:
#   ~/.local/bin/<command>                       terminal command
#   ~/.local/share/applications/<id>.desktop     menu entry
#   <desktop folder>/<id>.desktop                desktop icon (--desktop-icon)
#
# The command is a copy of archidev2-launch (next to this script) with two
# values filled in: this checkout's app and your usual project. The usual
# project must already have its .archidev2.ini; the launcher passes no settings.
# The menu entry and icon open a folder picker that starts at the usual project.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: install-launcher [--name CMD] [--desktop-icon] [USUAL_PROJECT_DIR]
       install-launcher --uninstall [--name CMD]

  --name CMD       terminal command name (default: ad2)
  --desktop-icon   also put an icon on the desktop
  --uninstall      remove what an earlier install with the same --name wrote

Afterwards:
  ad2                      open the usual project (folder picker if none was given)
  ad2 /path/to/project     open that project; one without .archidev2.ini gets first-run setup
  ad2 --choose             folder picker; the menu entry and desktop icon run this
Extra app options pass through, for example:  ad2 --developer-profile Codex
EOF
}

name=ad2 desktop_icon=0 uninstall=0 project=
while (($#)); do
  case $1 in
    --name) name=${2:?--name needs a value}; shift 2 ;;
    --desktop-icon) desktop_icon=1; shift ;;
    --uninstall) uninstall=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "install-launcher: unknown option $1" >&2; usage >&2; exit 2 ;;
    *) [[ -z $project ]] || { echo "install-launcher: one project only" >&2; exit 2; }
       project=$1; shift ;;
  esac
done
[[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "install-launcher: bad command name: $name" >&2; exit 2; }

bin_dir=${XDG_BIN_HOME:-$HOME/.local/bin}
app_dir=${XDG_DATA_HOME:-$HOME/.local/share}/applications
desk_dir=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
id=archidev2-$name
cmd=$bin_dir/$name
entry=$app_dir/$id.desktop
icon_file=$desk_dir/$id.desktop

if ((uninstall)); then
  for f in "$cmd" "$entry" "$icon_file"; do
    # Only remove files this script generated.
    if [[ -f $f ]] && grep -q 'Generated by ArchiDev2 install-launcher' "$f"; then
      rm -- "$f"; echo "removed $f"
    fi
  done
  exit 0
fi

here=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
if [[ -n $project ]]; then
  project=$(cd -P -- "$project" && pwd -P) || exit 2
  [[ -f $project/.archidev2.ini ]] || {
    echo "install-launcher: $project has no .archidev2.ini; open it once first: $here/archidev2-launch $project" >&2
    exit 3
  }
fi

repo=$(cd -P -- "$here/../.." && pwd -P)
app=$repo/build/qt-spike/archidev2-qt
src=$here/archidev2-launch
[[ -f $src ]] || { echo "install-launcher: missing $src" >&2; exit 1; }
[[ -x $app ]] || echo "install-launcher: warning: $app is not built yet" >&2

if [[ -e $cmd ]] && ! grep -q 'Generated by ArchiDev2 install-launcher' "$cmd"; then
  echo "install-launcher: $cmd exists and was not made by this script; choose another --name" >&2
  exit 4
fi

mkdir -p -- "$bin_dir" "$app_dir"

# Same line count as the source, so its --help text still lines up.
marker='# Generated by ArchiDev2 install-launcher from spikes/qt/archidev2-launch. Re-run it to change; --uninstall removes.'
# Values go through ENVIRON: awk -v would eat the backslashes printf %q adds.
L_MARK=$marker L_APP="AD2_APP=$(printf %q "$app")" \
L_PROJ="AD2_DEFAULT_PROJECT=$(printf %q "$project")" awk '
  NR == 2 { print ENVIRON["L_MARK"]; next }
  /^AD2_APP=/ { print ENVIRON["L_APP"]; next }
  /^AD2_DEFAULT_PROJECT=/ { print ENVIRON["L_PROJ"]; next }
  { print }' "$src" >"$cmd.tmp"
grep -q '^AD2_APP=/' "$cmd.tmp" || { rm -f -- "$cmd.tmp"; echo "install-launcher: could not set the app path" >&2; exit 1; }
chmod 755 "$cmd.tmp"
mv -f -- "$cmd.tmp" "$cmd"
echo "wrote $cmd"

desktop_entry() {
  cat <<EOF
[Desktop Entry]
# Generated by ArchiDev2 install-launcher. Re-run it to change; --uninstall removes.
Type=Application
Name=ArchiDev2
GenericName=AI project workspace
Comment=Choose a project folder to open in ArchiDev2${project:+ (starts at $(basename -- "$project"))}
Exec="$cmd" --choose
Icon=$repo/spikes/qt/archidev2.svg
Terminal=false
Categories=Development;
StartupWMClass=archidev2-qt
EOF
  if [[ -n $project ]]; then
    cat <<EOF
Actions=usual;

[Desktop Action usual]
Name=Open $(basename -- "$project") directly
Exec="$cmd"
EOF
  fi
}

desktop_entry >"$entry"
chmod 644 "$entry"
echo "wrote $entry"
command -v desktop-file-validate >/dev/null && desktop-file-validate "$entry"
command -v update-desktop-database >/dev/null && update-desktop-database -q "$app_dir" 2>/dev/null || true

if ((desktop_icon)); then
  mkdir -p -- "$desk_dir"
  desktop_entry >"$icon_file"
  chmod 755 "$icon_file"
  # Cinnamon and GNOME only run desktop files marked as trusted.
  gio set "$icon_file" metadata::trusted true 2>/dev/null || true
  echo "wrote $icon_file"
fi

case ":$PATH:" in *":$bin_dir:"*) ;; *) echo "note: $bin_dir is not on PATH" >&2 ;; esac
